<Window
    x:Class="v2rayN.Views.HeyGeLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HeyGe 登录并同步"
    Width="480"
    Height="420"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="登录 HeyGe，同步我的有效节点" />
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,18"
            Foreground="#666666"
            TextWrapping="Wrap"
            Text="只同步未到期的 VLESS 节点到一个 HeyGe 分组。密码只用于本次 HTTPS 登录，不会保存在客户端。" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="网站地址" />
            <TextBox x:Name="txtSite" Margin="0,4,0,12" Text="https://ananx.cc" />
            <TextBlock Text="网站账号（邮箱）" />
            <TextBox x:Name="txtEmail" Margin="0,4,0,12" />
            <TextBlock Text="网站密码" />
            <PasswordBox x:Name="txtPassword" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock
            x:Name="txtStatus"
            Grid.Row="3"
            Margin="0,14,0,8"
            Foreground="#B42318"
            TextWrapping="Wrap" />
        <Grid Grid.Row="4">
            <CheckBox
                x:Name="chkDontPromptAgain"
                VerticalAlignment="Center"
                Content="以后启动时不再提示登录" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="btnCancel" Width="96" Margin="0,0,8,0" Content="取消" IsCancel="True" />
                <Button x:Name="btnLogin" Width="132" Content="登录并同步" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
